# Copiar como .env y completar. Nunca subir el .env al repositorio.

# Token del bot que da @BotFather en Telegram
TELEGRAM_BOT_TOKEN=

# Proveedor del modelo de IA: openai o anthropic
LLM_PROVIDER=openai

# OpenAI (platform.openai.com > API keys). La misma key sirve para transcribir los audios.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.5
# none, minimal, low, medium, high
OPENAI_REASONING_EFFORT=low
OPENAI_TRANSCRIBE_MODEL=gpt-4o-mini-transcribe

# Anthropic (solo si LLM_PROVIDER=anthropic)
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5-5
CLAUDE_EFFORT=medium

# Transcripción de audios: openai, local (faster-whisper) o groq
TRANSCRIPCION=openai
GROQ_API_KEY=

# Chat de Telegram del director de proyectos: recibe copia de cada PDF (opcional)
DIRECTOR_CHAT_ID=

# --- WhatsApp Cloud API (python main.py whatsapp). Ver docs/WHATSAPP.md ---
# Token de acceso (temporal del Paso 1 para probar; después, el permanente del usuario del sistema)
WHATSAPP_TOKEN=
# Paso 1 > "Phone Number ID" del número que usa el bot
WHATSAPP_PHONE_NUMBER_ID=
# Configuración de la app > Básica > Clave secreta de la app (para comprobar que los mensajes vienen de Meta)
WHATSAPP_APP_SECRET=
# Texto que inventás vos; el mismo se pega en Meta al configurar el webhook
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_PUERTO=8085
WHATSAPP_RUTA=/whatsapp/webhook
# Plantilla aprobada para el recordatorio cuando pasaron más de 24 h del último mensaje del DT (opcional)
WHATSAPP_PLANTILLA_RECORDATORIO=
# Teléfono del director de proyectos: recibe copia de cada PDF (opcional)
WHATSAPP_DIRECTOR=

HORA_RECORDATORIO=18:00
MIN_FOTOS=3
MARGEN_PEDIDO_DIAS=2
