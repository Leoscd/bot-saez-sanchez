# Copiar como .env y completar. Nunca subir el .env al repositorio.

# Token del bot que da @BotFather en Telegram
TELEGRAM_BOT_TOKEN=

# API key de Anthropic (console.anthropic.com)
ANTHROPIC_API_KEY=

# Modelo y nivel de razonamiento (low, medium, high)
CLAUDE_MODEL=claude-opus-5-5
CLAUDE_EFFORT=medium

# Transcripción de audios: local (faster-whisper en esta PC) o groq (API, para el VPS)
TRANSCRIPCION=local
WHISPER_MODEL=small
GROQ_API_KEY=

# Chat de Telegram del director de proyectos: recibe copia de cada PDF (opcional)
DIRECTOR_CHAT_ID=

HORA_RECORDATORIO=18:00
MIN_FOTOS=3
MARGEN_PEDIDO_DIAS=2
